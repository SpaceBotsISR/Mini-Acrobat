<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_acrobat_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs that start the Mini-Acrobat nodes together with the rosbridge and Foxglove bridges.</description>
  <maintainer email="kiko.castelobranco@gmail.com">Francisco Branco</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mini_acrobat_safety</exec_depend>
  <exec_depend>mini_acrobat_link</exec_depend>
  <exec_depend>mini_acrobat_hardware</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
