<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_acrobat_link</name>
  <version>0.1.0</version>
  <description>Publishes the drone's network status (Wi-Fi signal, IPs, Tailscale) on /link/status for the ground control app.</description>
  <maintainer email="kiko.castelobranco@gmail.com">Francisco Branco</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mini_acrobat_interfaces</exec_depend>
  <!-- `iw` (sudo apt install iw) gives SSID, bitrate and frequency; without it only the signal level is reported. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
